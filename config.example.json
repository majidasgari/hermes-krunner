{
  "_comment": "هرمـس در KRunner — این فایل را در ~/.config/hermes-krunner/config.json بگذارید. هر کلید اختیاری است.",
  "triggers": [
    "?",
    "؟",
    "hermes",
    "هرمس",
    "ana",
    "آنا",
    "kattie",
    "کتی"
  ],
  "session_title": "⚡ پرسش سریع",
  "engine": "auto",
  "launch_app_if_down": true,
  "app_start_timeout_s": 60,
  "inline_wait_s": 18,
  "answer_timeout_s": 240,
  "session_rotate_after_messages": 60,
  "cache_size": 120,
  "inline_answer_chars": 1500,

  "_comment_sending": "حین تایپ هیچ درخواستی به مدل نمی‌رود؛ فقط با اینتر، علامت سؤال در متن، یا نشانه پرسیده می‌شود",
  "auto_ask": true,
  "auto_ask_on_question_mark": true,
  "debounce_ms": 700,
  "min_question_chars": 3,

  "_comment_suggestion": "برای هر متن ساده یک ردیف پیشنهاد «از هرمس بپرس» نشان داده می‌شود (بدون تماس با مدل)",
  "suggest_untriggered": true,
  "min_suggest_chars": 3,
  "suggest_relevance": 0.5,
  "suggest_category_relevance": 50,

  "notify": true,
  "notify_inline_answers": false,
  "show_hint_when_empty": true,
  "app_window_class": ["com.nousresearch.hermes"],
  "idle_exit_minutes": 20,
  "log_level": "INFO"
}
